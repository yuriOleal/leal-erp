# ── Supabase ──────────────────────────────────────────────
# Crie um projeto em https://supabase.com e obtenha as credenciais abaixo
# em Project Settings > API

# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Chave anônima pública (anon/public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ── App ───────────────────────────────────────────────────
# URL base da aplicação (ex: http://localhost:3000 para dev local,
# ou https://seu-dominio.vercel.app para produção)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
